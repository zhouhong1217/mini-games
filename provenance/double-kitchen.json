  "changes": [
    "Remove platform HTML, base.xml, h5api loader and vendor SDK files from publication.",
    "Remove six vendor modules and their bootstrap entries; replace AD dispatch with independent local adapter.",
    "Replace serialized native-ad components while preserving component UUIDs and serialized properties.",
    "Remove vendor calls from menu, privacy, channel and online-reward components.",
    "Namespace localStorage as double-kitchen-4399-v1; preserve game data schema.",
    "Send readiness after Menu scene launch; serve only same-origin static resources.",
    "Normalize boot/CSS line endings and trailing whitespace."
  ],
  "ad_callbacks": "Rewarded default: stopMusic; wait 100ms; AD.reward(callback, context) once with zero callback arguments; restore music. Each request captures its own callback and is queued. Optional provider lives only in platform-adapter.js.",
  "preserved": "Game logic, scene graphs, native image/audio assets and engine bytes are preserved except listed module and boot changes.",
  "unknowns": [
    "Full equivalence of all gameplay paths and late progression is Unknown until runtime coverage is expanded.",
    "Shared texture atlases may retain visual branding or unused advertisement artwork; arbitrary binary-internal dependency absence is Unknown."
  ],
