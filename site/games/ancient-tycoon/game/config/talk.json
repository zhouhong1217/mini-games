{
    "1": [
        {
            "people": 1,   
            "desc": "大夫你好"    
        },
        {
            "people": 2,   
            "desc": "你好，请问你身上哪里不舒服？"    
        },
        {
            "people": 1,   
            "desc": "俺肚子疼，疼了一宿"    
        },
        {
            "people": 2,   
            "desc": "是绞痛吗？"    
        },
        {
            "people": 1,   
            "desc": "大夫，我的肚子疼，脚不疼"    
        },
        {
            "people": 2,   
            "desc": "你的肚子有没有绞痛？"    
        },
        {
            "people": 1,   
            "desc": "大夫你会不会看病啊，我都说了我的脚不疼！"    
        }
