    "2": [
        {
            "people": 1,   
            "desc": "大夫，我好冷啊~"    
        },
        {
            "people": 2,   
            "desc": "过来让我先把个脉"    
        },
        {
            "people": 1,   
            "desc": "我感觉自己浑身发凉。"    
        },
